+    // The repacker writes the resource using "name" + ".dat" (e.g. RES.dat). On case-sensitive
+    // filesystems that differs from the ISO name (RES.DAT), so resolve the actual file.
+    private static string ResolveResourcePath(string dataDir, string resourceFile) {
+        string extractedDir = Path.Combine(dataDir, "Extracted");
+        string expected = Path.Combine(extractedDir, resourceFile);
+        if (File.Exists(expected))
+            return expected;
+
+        string candidate = Path.Combine(extractedDir, Path.GetFileNameWithoutExtension(resourceFile) + ".dat");
+        if (File.Exists(candidate))
+            return candidate;
+
+        return expected;
+    }
